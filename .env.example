# Middleware Supabase executado no servidor
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

# Variáveis públicas incorporadas ao frontend pelo Vite
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Nunca adicione SUPABASE_SERVICE_ROLE_KEY a este arquivo ou ao frontend.

# Secrets exclusivos da Edge Function de cache. Configure-os apenas no Supabase
# (ou em um arquivo local ignorado pelo Git para testes); nunca use o prefixo VITE_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
